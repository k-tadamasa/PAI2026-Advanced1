    "record:video": "node scripts/record-realtime.mjs",
    "record:section": "node scripts/record-section.mjs",
    "record:presentation": "node scripts/record-presentation.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
