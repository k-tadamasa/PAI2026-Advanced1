    "three": "^0.181.0",
    "urdf-loader": "^0.12.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.55.0",
    "typescript": "^5.7.2",
