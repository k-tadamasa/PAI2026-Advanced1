{
  "name": "pai-body-screening-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "capture:video": "node scripts/capture-video.mjs",
